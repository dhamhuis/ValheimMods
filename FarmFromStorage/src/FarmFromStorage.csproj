<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <OutputType>Library</OutputType>
    <AssemblyName>FarmFromStorage</AssemblyName>
    <RootNamespace>FarmFromStorage</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <Version>1.0.0</Version>
    <Authors>Hoose</Authors>
    <Company>Hoose</Company>
    <Product>Valheim FarmFromStorage</Product>
    <Description>Plant with the Cultivator using accessible nearby storage.</Description>
    <Copyright>Copyright (c) Hoose 2026</Copyright>
    <ValheimInstallDir Condition="'$(ValheimInstallDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Valheim</ValheimInstallDir>
    <ValheimManagedDir Condition="'$(ValheimManagedDir)' == ''">$(ValheimInstallDir)\valheim_Data\Managed</ValheimManagedDir>
    <R2ModmanProfileDir Condition="'$(R2ModmanProfileDir)' == ''">$(APPDATA)\r2modmanPlus-local\Valheim\profiles\Valheim Mod Building</R2ModmanProfileDir>
    <BepInExCoreDir Condition="'$(BepInExCoreDir)' == ''">$(R2ModmanProfileDir)\BepInEx\core</BepInExCoreDir>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>portable</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\ValheimMods.Common\src\ValheimMods.Common.csproj" />
    <Reference Include="BepInEx"><HintPath>$(BepInExCoreDir)\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(ValheimManagedDir)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(ValheimManagedDir)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="ValidateBuildReferences" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(ValheimManagedDir)\UnityEngine.CoreModule.dll')" Text="Valheim managed assemblies not found. Set ValheimInstallDir or ValheimManagedDir." />
    <Error Condition="!Exists('$(BepInExCoreDir)\BepInEx.dll')" Text="BepInEx core not found. Set R2ModmanProfileDir or BepInExCoreDir." />
  </Target>
</Project>